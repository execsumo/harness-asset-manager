# Local tool state — machine-specific, expensive to rebuild, never shared
.codegraph/
.rtk/

# Delegate-agent scaffolding (spawn writes this per worktree: notify helper + signal file).
# Per-run and machine-local — it must never be committed.
# No trailing slash: a trailing slash matches directories only, so a symlink of the same
# name slips through. That is exactly how .venv and node_modules leaked into git status.
.delegate

# Per-agent instruction files generated by local tooling (rtk init and friends).
# Shared working agreements belong in CLAUDE.md; these do not.
.clinerules
.agents/
