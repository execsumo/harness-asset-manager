{
  "name": "harness-asset-manager",
  "private": true,
  "version": "0.5.15",
  "type": "module",
  "scripts": {
    "dev": "VITE_API_BASE=/api vite --host 127.0.0.1 --port 5173",
    "dev:backend": "./.venv/bin/python -m harness_asset_manager serve --host 127.0.0.1 --port 8000 --no-open-browser",
    "install:dev": "bash scripts/install-dev.sh",
    "start:dev": "bash scripts/start-dev.sh",
    "stop:dev": "bash scripts/stop-dev.sh",
    "version:sync": "python3 scripts/sync_version.py --check",
    "build:release": "./.venv/bin/python scripts/build_release.py",
    "build": "VITE_API_BASE=/api vite build",
    "lint:frontend": "eslint frontend/src",
    "lint:backend": "./.venv/bin/ruff check harness_asset_manager tests scripts",
    "lint:backend:fix": "./.venv/bin/ruff check --fix harness_asset_manager tests scripts",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "./.venv/bin/pyright",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "release-targets:check": "node scripts/check_release_targets_js.cjs",
    "audit:check": "node scripts/audit_gate.cjs",
    "codegen:openapi": "./.venv/bin/python scripts/dump_openapi.py && openapi-typescript frontend/src/api/openapi.json -o frontend/src/api/generated.ts",
    "codegen:check": "npm run codegen:openapi && git diff --exit-code frontend/src/api/openapi.json frontend/src/api/generated.ts",
    "validate": "npm run lint:backend && npm run typecheck:backend && bash scripts/test_backend.sh && npm run lint:frontend && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
